{
  "name": "dsh-voice-studio",
  "version": "1.0.0",
  "description": "Voice Studio for DeepSeek Harness: a sidebar panel that manages GPT-SoVITS voices (training, switching, speaking) and RVC covers (voice conversion, separation, mixing) on Windows.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "gpt-sovits",
    "rvc",
    "voice",
    "cover"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": { "node": ">=22" },
  "os": ["win32"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["slots"] }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-NAME/dsh-voice-studio.git"
  },
  "homepage": "https://github.com/YOUR-NAME/dsh-voice-studio#readme",
  "bugs": {
    "url": "https://github.com/YOUR-NAME/dsh-voice-studio/issues"
  },
  "author": "YOUR-NAME",
  "license": "MIT"
}
